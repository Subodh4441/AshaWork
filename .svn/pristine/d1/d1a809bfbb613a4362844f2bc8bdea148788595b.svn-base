* {
    margin: 0px;
    padding: 0px;
    box-sizing: border-box;
  }
  
  html, body {
    overflow: hidden;
  }
  
  body {
    margin: 0px;
    padding: 0px;
    /* overflow: hidden; */
    --scroll-bar-w: 13px;
    max-width: 100%;
    overflow: hidden;
    background: #fff;
    font-family: 'Open Sans', sans-serif;
    color: #676767;
    position: relative;
  }
  
  a{
    text-decoration: none !important;
  }
  
  .login-left-container{
    background-size: cover;
    background-image: url(/assets/images/Home-Hero.jpg);
  }
  
  .crousal-container{
    display: flex;
    align-items: center;
    height: 100vh;
  }
  
  .crousal-container h1{
    font-size: 60px;
    padding-left: 100px;
    color: white;
    font-weight: 600;
    line-height: 1.3;
  }
  
  .crousal-container h1 span{
    display: block;
    color: #FF8728;
  }
  
  .crousal-container p{
    padding-left: 100px;
    padding-right: 30px;
    font-size: 22px;
    color: white;
    margin-top: 30px;
  }
  
  .login-right-container {
    background-color: #231F20;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  
  .login-right-container img{
    position: absolute;
    top: 4%;
    right: 5%;
    height: 55px;
    object-fit: contain;
  }
  
  .login-right-container .login-form{
    text-align: center;
  }
  
  .login-right-container .login-form h1{
    color: #fff;
    font-size: 45px;
    margin-bottom: 40px;
  }
  
  .input-filed{
    border: 0;
    border-radius: 10px;
    background-color: #fff;
    color: #231F20;
    font-size: 18px;
    width: 230px;
    height: 60px;
    display: block;
    margin-bottom: 40px;
    padding: 0 15px;
  }

  select.input-filed{
    border: 0px;
    border-radius: 10px;
  }
  
  input:focus{
    outline: none;
    border: 1px solid #FF8728;
    box-shadow: 0;
  }
  
  .input-filed-pass{
    margin-bottom: 10px !important;
  }
  
  
  .forgot{
    font-size: 14px;
    color: #fff;
    text-align: right;
    text-decoration: none;
  }
  
  a.button{
    display: block;
    padding: 10px 25px;
    background-color: #FF8728;
    color: #fff;
    margin: 0 auto !important;
    border: 0px;
    border-radius: 50px !important;
    height: 60px;
    width: 180px;
    font-size: 27px !important;
  }
  
  header{
    width: 100%;
    padding: 15px 10px;
    background-color: #fff;
    box-shadow: 0 0px 4px rgba(0, 0, 0, 0.19), 0 2px 9px rgba(0, 0, 0, 0.23);
    position: fixed;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 11111111;
    height: 11vh;
  }
  
  header .logo{
    height: 50px;
    object-fit: contain;
  }
  
  .profile, .export {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }
  
  .profile h3 {
    text-align: end;
    line-height: 1;
    margin-bottom: 4px;
    font-weight: 600;
  }
  
  .profile p {
    line-height: 1;
    font-size: 14px;
    opacity: .6;
    color: #000;
  }
  
  .profile .img-box {
    position: relative;
    width: 75px;
    height: 75px;
    border-radius: 50%;
    overflow: hidden;
  }
  
  .profile .img-box img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* menu (the right one) */
  
  .menu, .exportmenu {
    position: absolute;
    top: calc(100% + 5px);
    left: 5px;
    width: 200px;
    min-height: 100px;
    background: #fff;
    box-shadow: 0 10px 20px rgba(0, 0, 0, .2);
    opacity: 0;
    transform: translateY(-10px);
    visibility: hidden;
    transition: 300ms;
  }
  
  .actionbuttons{
    position: relative;
  }
  
  .menu.active, .exportmenu.active {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    border-radius: 10px !important;
  background-color: #fff !important;
  }
  .exportmenu.active {
    z-index: 111111111111111111111111111111111111111;
    top: 65px;
  }
  
  /* menu links */
  
  .menu ul, .exportmenu ul {
    position: relative;
    display: flex;
    flex-direction: column;
    z-index: 10;
    background: #fff;
    padding: 0px;
    margin:10px 0 ;
  }
  
  .menu ul li, .exportmenu ul li {
    list-style: none;
    border-bottom: 1px solid #f1f1f1;
  }
  .menu ul li:last-child, .exportmenu ul li:last-child {
    border: 0;
  }
  
  .menu ul li:hover, .exportmenu ul li:hover {
    background: #eee;
  }
  
  .menu ul li a, .exportmenu ul li a {
    text-decoration: none;
    color: #000;
    display: flex;
    align-items: center;
    padding: 15px 20px;
    gap: 6px;
  }
  
  .menu ul li a i .exportmenu ul li a i{
    font-size: 1.2em;
  }
  
  
  .left-side-bar{
    background-color: #231F20;
    height: 89vh;
  }
  
  main{
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 89vh;
  }
  
  .card{
    border-radius: 0px !important;
  }
  
  .left-side-bar{
    padding: 0px !important;
    width: 15%;
  }
  
  .left-side-bar .card{
    border: 0px;
  }
  
  .left-side-bar .card-header{
    background-color: #231F20;
    border-radius: 0 !important;
    border: 1px solid #535353;
  }
  
  .left-side-bar .card h5 button{
    font-size: 1.2rem;
    color: #fff;
    background-color: #231F20;
    text-decoration: none;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .left-side-bar .card .card-body{
    background-color: #F3F1F6;
    padding: 0;
  }
  
  .left-side-bar .card .card-body a{
    display: block;
    width: 100%;
    background-color: #F3F1F6;
    color: #231F20;
    padding: 10px 25px;
    font-size: 1.2rem;
  }
  .left-side-bar .card .card-body a:hover{
    color: #fff;
    background-color: #FF8728;
  }
  .left-side-bar .card .btn-link:active{
    color: #fff;
  }
  
  .right-side-container{
    width: 85%;
    padding: 20px;
  }
  
  .right-side-content{
    border-radius: 15px;
    width: 100%;
    height: 100%;
    padding: 10px 30px;
    background-color: #F3F1F6;
    height: 86vh;
    overflow: hidden;
  }
  
  .table-scroll{
    height: 67vh;
    overflow-y: scroll;
    scrollbar-width: thin; /* For Firefox */
    scrollbar-color: #747474 #f0f0f0; /* For Firefox: color and background */
  }
  
  /* For WebKit-based browsers (Chrome, Edge, Safari) */
  .table-scroll::-webkit-scrollbar {
  width: 10px; /* Width of the vertical scrollbar */
  height: 10px; /* Height of the horizontal scrollbar */
  }
  
  .table-scroll::-webkit-scrollbar-track {
  background: #f0f0f0; /* Background of the track */
  }
  
  .table-scroll::-webkit-scrollbar-thumb {
  background-color: #FF8728; /* Scrollbar thumb color */
  border-radius: 10px; /* Rounded corners */
  border: 2px solid #f0f0f0; /* Adds space between thumb and track */
  }
  
  .table-scroll::-webkit-scrollbar-thumb:hover {
  background-color: #FF8728; /* Change color on hover */
  }
  
  .table-scroll::-webkit-scrollbar-corner {
  background: #f0f0f0; /* Corner background for when both scrollbars are visible */
  }
  
  
  @media (min-width: 1200px) and (max-width: 1360px) {
    .login-right-container img {
        top: 3%;
        height: 45px;
    }
    .login-right-container .login-form h1{
        font-size: 42px;
    }
    .input-filed{
        width: 300px;
    }
    .crousal-container h1{
        font-size: 50px;
        padding-left: 70px;
    }
    .crousal-container p{
        font-size: 16px;
        padding-left: 70px;
    }
  }
  
  @media (max-width: 1200px) {
    .login-right-container img {
        top: 3%;
        height: 45px;
    }
    .login-right-container .login-form h1{
        font-size: 42px;
    }
    .input-filed{
        width: 300px;
    }
    .crousal-container h1{
        font-size: 46px;
        padding-left: 70px;
    }
    .crousal-container p{
        font-size: 15px;
        padding-left: 70px;
    }
  }
  
  @media screen and (max-width: 992px) {
    .login-right-container .login-form h1 {
        font-size: 34px;
    }
  
    .input-filed {
        width: 260px;
        font-size: 17px;
    }
    .crousal-container h1{
        font-size: 38px;
        padding-left: 50px;
    }
    .crousal-container p{
        padding-left: 50px;
    }
    a.button{
        width: 160px;
        font-size: 22px !important;
    }
  }
  
  
  
  
  
  
  
  /* dashboard */
  
  /* Table Styles */
  table {
  margin: auto;
  width: 100%;
  overflow: hidden;
  background-color: #fff; /* White background for the table */
  border-radius: 10px;
  position: relative;
  border-collapse: collapse;
  z-index: 1;
  color: #2b3c56; /* Gray text color */
  white-space: nowrap;
  }
  
  tbody tr:not(:last-child) {
  border-bottom: 1px solid rgba(1, 1, 1, 0.2);
  }
  
  th,
  td {
  padding: 1rem;
  gap: 10px;
  position: relative;
  cursor: default;
  text-align: center !important;
  }
  th:nth-child(2),
  td:nth-child(2) {
  text-align: left !important;
  }
  
  td:last-child:hover a {
  color: #000; /* Black on hover */
  }
  
  thead {
  background-color: #4400A5; /* Light blue background */
  color: #fff;
  }
  
  th {
  text-transform: uppercase;
  }
  
  td img {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 5px;
  }
  
  tr:first-child:hover {
  background-color: transparent; /* Light gray background on hover */
  }
  tr:hover {
  background-color: #f9f9f9; /* Light gray background on hover */
  }
  
  td:last-child:hover:after {
  content: "Project";
  position: absolute;
  width: fit-content;
  left: -10%;
  top: -40%;
  transform: translate(0%, 50%);
  font-size: 12px;
  color: #f1f1f1; /* Light text color */
  background-color: #1d1e22; /* Dark background */
  box-shadow: rgba(0, 0, 0, 0.25) 0px 54px 55px, rgba(0, 0, 0, 0.12) 0px -12px 30px, rgba(0, 0, 0, 0.12) 0px 4px 6px,
    rgba(0, 0, 0, 0.17) 0px 12px 13px, rgba(0, 0, 0, 0.09) 0px -3px 5px;
  border-radius: 5px;
  padding: 2px 4px;
  z-index: 9;
  }
  
  table a {
  color: #2b3c56; /* Gray link color */
  }
  
  /* ICONS */
  
  .active,
  .inactive {
  padding: 0.3rem 0.8rem;
  border-radius: 40px;
  }
  
  .active {
  background-color: #C1DCC3;
  color: #107717;
  }
  
  .inactive {
  background-color: #FFBDBD;
  color: #FF0000;
  }
  
  @media (max-width: 720px) {
  main {
    background: #5487fa; /* Blue */
  }
  
  table {
    background-color: transparent;
  }
  
  main {
    overflow-y: auto;
    height: 100%;
  }
  
  table thead {
    display: none;
  }
  
  table td {
    width: 100%;
    display: block;
    text-align: right;
  }
  
  table td:not(:last-child) {
    border-bottom: 1px solid rgba(1, 1, 1, 0.2);
  }
  
  table td:before {
    content: attr(data-label);
    z-index: 1;
    float: left;
    color: #000; /* Black */
  }
  
  tr {
    background-color: #fff; /* White */
    border-radius: 5px;
    display: block;
    margin: 0.5rem 0;
  }
  
  tbody tr {
    border-bottom: none;
  }
  
  tr td {
    text-align: right !important;
  }
  
  tr td:first-child {
    text-align: center !important;
  }
  
  tr td{
    text-align: center !important;
  }
  
  td:last-child:hover:after {
    left: auto;
    right: 10%;
    transform: translate(50%, 50%);
  }
  
  th,
  td {
    padding: 0.5rem 1rem;
  }
  }
  
  .fa-solid.fa-filter{
    padding-left: 20px;
  }
  
  hr{
    color: #FFFFFF;
  }
  
  h1.headline{
    font-size: 35px;
    color: #231F20;
    font-weight: 500;
    margin-top: 15px;
  }
  button{
    margin-top: 0 !important;
    padding: 10px 30px;
    color: #fff;
    background-color: #FF8728;
    border: 0;
    width: auto;
    border-radius: 50px !important;
  }
  
  .right-side-container .input-filed{
    height: 50px;
    margin-bottom: 0px;
  }
  
  .tabletopbuttons{
    display: flex;
    justify-content: space-between;
  }
  
  .searchcontainer {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .searchcontainer .input-filed{
    margin-right: 20px;
  }
  
  .actionbuttons{
    display: flex;
    align-items: flex-start;
  }
  .actionbuttons button{
    margin-left: 20px;
  }
  
  table .fa-solid:hover, table .fas:hover{
    color: #FF8728;
  }
  
  
  dialog{
  width:100vw;
  height:100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #00000041;
  }
  .dialog-container{
  width:500px;
  max-height:400px;
  padding:30px 30px 70px 30px;
  border:0;
  box-shadow:0 0 10px rgba(0,0,0,0.2);
  border-radius:5px;
  position:relative;  
  background-color: #fff;
  }
  
  dialog button{
  position:absolute;
  bottom:20px;
  right:30px;
  background:#000000;
  color:#ffffff;
  }
  p{
  color:#aaa;
  padding-bottom:10px;
  line-height:2;
  font-size:14px;
  }
  
  /* dashboard */


  .cdk-global-scrollblock{
    overflow: hidden !important;
  }

  button.export{
    height: 40px;
    width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0px;
    font-size: 16px;
  }