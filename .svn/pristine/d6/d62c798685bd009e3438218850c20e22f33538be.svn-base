<!-- MAIN CONTENT -->
<div id="content">
    <!-- row -->
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="row">
                <div class="col-sm-12">
                    <div class="text-center error-box well">
                        <h2 class="error-text animated slideInDown"><i
                                class="fa fa-sign-out text-danger error-icon-shadow"></i>Logged Out</h2>

                        <br>
                        <p class="lead semi-bold">
                            <strong>Your current session have been successfully logged out.<br>
                                Thank You..!
                            </strong>
                        </p>
                        <br>
                        <div class="text-align-center margin-top-10">
                            <button class="btn btn-lg bg-color-blueDark txt-color-white" (click)="login()"><i
                                    class="fa fa-power-off"></i>&nbsp;Login again</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MAIN CONTENT -->