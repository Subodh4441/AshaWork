<div class="popup-header">
    <h4><b>{{savetext}} SpareVariant</b></h4>
    <a (click)="onCancel()" aria-label="Close"><i class="fa-solid fa-xmark"></i></a>
</div>


<div class="popup-body">
    <div class="form-container">
        <div class="row" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <!-- Spare Variant -->
            <div class="col-xl-6 col-md-6 col-lg-6">
                <label for="spareVariant" class="d-block">Spare Variant</label>
                <input
                id="spareVariant"
                type="text"
                maxlength="10"
                placeholder="Spare Variant"
                class="input-filed"
                [(ngModel)]="sparevariant"
                (ngModelChange)="onSpareVariantInput()"
              />
              
            </div>

            <!-- Spare Variant ID -->
            <div class="col-xl-6 col-md-6 col-lg-6">
                <label for="spareVariantId" class="d-block">Spare Variant ID</label>
                <input
                    id="spareVariantId"
                    type="text"
                    placeholder="Enter Spare Variant ID"
                    class="input-filed"
                    [(ngModel)]="sparevariantId"
                    name="sparevariantId"
                    required
                
                />
            </div>

            <!-- Spare Name -->
            <div class="col-xl-6 col-md-6 col-lg-6">
                <label for="spareName" class="d-block">Spare Name</label>
                <select
                  id="spareName"
                  class="input-filed"
                  [(ngModel)]="sparename"
                  name="sparename"
                >
                  <option value="" disabled selected>--- Select Spare Name ---</option>
                  <option *ngFor="let spare of spares" [value]="spare.spareName">
                    {{ spare.spareName }}
                  </option>
                </select>
              </div>
              

            <!-- Active Checkbox -->
            <div class="col-xl-6 col-md-6 col-lg-6">
                <label for="isActive" class="d-block">Active</label>
                <input
                    id="isActive"
                    type="checkbox"
                    [(ngModel)]="isActive"
                    name="isActive"
                />
            </div>
        </div>

        <!-- Save Button -->
        <div class="actions">
            <button (click)="onSaveSpareVariant()">{{savetext}}</button>
        </div>
    </div>
</div>
