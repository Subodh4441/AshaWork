   <div class="popup-backdrop">
    <!-- User Details Popup -->
    <div *ngIf="!isChangePassword">
      <div class="popup-header">
        <!-- <h3>{{ IsUpdateEnable ? 'Edit User' : 'Add User' }}</h3> -->
        <a (click)="onCancel()" class="close-button"><i class="fa-solid fa-xmark"></i></a>
      </div>
  
      <div class="row popup-body table-scroll">
        <!-- Login ID -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Login ID <span class="red-astrik">*</span></label>
          <input 
            type="text" 
            [(ngModel)]="LoginID" 
            name="LoginID"
            placeholder="Enter login ID" 
            class="input-filed"
            [readonly]="!!user" 
            required 
            [disabled]="IsUpdateEnable"/>
        </div>
  
        <!-- User Name -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">User Name <span class="red-astrik">*</span></label>
          <input 
            type="text" 
            [(ngModel)]="userName" 
            name="userName"
            placeholder="Enter user name" 
            class="input-filed"
            required 
          />
        </div>
  
        <!-- Role ID -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Role <span class="red-astrik">*</span></label>
          <select [(ngModel)]="RoleName" name="RoleName" class="input-filed" required>
            <option *ngFor="let role of RoleList" [value]="role.id">{{ role.name }}</option>
            <!-- <option value="">---Select Role---</option>
            <option [value]="1">Admin</option>
            <option [value]="2">User</option> -->
          </select>
        </div>
  
        <!-- Branch Group ID -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Branch Group</label>
          <select [(ngModel)]="BranchUserGroup" name="BranchUserGroup"class="input-filed">
            <option value="">---Select Branch Group---</option>
            <option [value]="1">Group A</option>
            <option [value]="2">Group B</option>
          </select>
        </div>
  
        <!-- Employee Code -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Employee Code <span class="red-astrik">*</span></label>
          <input 
            type="number" 
            [(ngModel)]="EmployeeID" 
            name="EmployeeID"
            placeholder="Enter employee code" 
            class="input-filed"
            required 
          />
        </div>
  
        <!-- Mobile Number -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Mobile Number <span class="red-astrik">*</span></label>
          <input 
            type="text" 
            [(ngModel)]="MobileNumber" 
            name="MobileNumber"
            placeholder="Enter mobile number" 
            class="input-filed"
            required 
          />
        </div>
  
        <!-- Email ID -->
        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Email ID</label>
          <input 
            type="email" 
            [(ngModel)]="EmailID" 
            name="EmailID"
            placeholder="Enter email ID" 
            class="input-filed"
          />
        </div>

        <div class="col-xl-6 col-md-6 col-lg-6">
          <label class="d-block">Active</label>
          <input type="checkbox" [(ngModel)]="isActive" /> 
        </div>
  
        <!-- Actions -->
        <div class="actions">
          <button type="button" (click)="save()">{{ IsUpdateEnable ? 'Update' : 'Save' }}</button>
          <button type="button" (click)="onCancel()">Cancel</button>
          <!-- <button type="button" (click)="toggleChangePassword()">Change Password</button> -->
        </div>
      </div>
    </div>
  
    <!-- Change Password Popup -->
    <div *ngIf="isChangePassword" class="popup-container">
      <div class="popup-header">
        <h3>Change Password</h3>
        <a (click)="onCancel()" class="close-button">X</a>
      </div>
  
      <form>
        <!-- Old Password -->
        <div class="form-group">
          <label>Old Password <span class="red-astrik">*</span></label>
          <input 
            type="password" 
            [(ngModel)]="oldPassword" 
            name="oldPassword"
            placeholder="Enter old password" 
            required 
          />
        </div>
  
        <!-- New Password -->
        <div class="form-group">
          <label>New Password <span class="red-astrik">*</span></label>
          <input 
            type="password" 
            [(ngModel)]="newPassword" 
            name="newPassword"
            placeholder="Enter new password" 
            required 
          />
        </div>
  
        <!-- Confirm Password -->
        <div class="form-group">
          <label>Confirm Password <span class="red-astrik">*</span></label>
          <input 
            type="password" 
            [(ngModel)]="confirmPassword" 
            name="confirmPassword"
            placeholder="Confirm new password" 
            required 
          />
        </div>
  
        <!-- Actions -->
        <div class="form-actions">
          <button type="button" (click)="savePassword()">Save Password</button>
          <button type="button" (click)="onCancel()">Cancel</button>
        </div>
      </form>
    </div>
  </div>
  