* {
  margin: 0px;
  padding: 0px;
  box-sizing: border-box;
}

html, body {
  overflow: hidden;
}

body {
  margin: 0px;
  padding: 0px;
  /* overflow: hidden; */
  --scroll-bar-w: 13px;
  max-width: 100%;
  overflow: hidden;
  background: #fff;
  font-family: 'Open Sans', sans-serif;
  color: #676767;
  position: relative;
}

a{
  text-decoration: none !important;
}

.login-left-container{
  background-size: cover;
  /* background-image: url(/assets/images/Home-Hero.jpg); */
}

/* .crousal-container{
  display: flex;
  align-items: center;
  height: 100vh;
  width: 100vw;
} */

.crousal-container h1{
  font-size: 60px;
  padding-left: 100px;
  color: white;
  font-weight: 600;
  line-height: 1.3;
}

.crousal-container h1 span{
  display: block;
  color: #FF8728;
}

.crousal-container p{
  padding-left: 100px;
  padding-right: 30px;
  font-size: 22px;
  color: white;
  margin-top: 30px;
}

.login-right-container {
  background-color: #231f205e;
  height: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  position: absolute;
  padding: 20px;
  right: 9%;
  top: 19%;
  border-radius: 16px;
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.login-right-container img{
  height: 55px;
  object-fit: contain;
  margin-bottom: 30px;
}

.login-right-container .login-form{
  text-align: center;
}
.login-right-container .login-form input{
  width: 100%;
}

.login-right-container .login-form h1{
  color: #fff;
  font-size: 45px;
  margin-bottom: 40px;
}

.input-filed{
  border: 0;
  border-radius: 10px;
  background-color: #fff;
  color: #231F20;
  font-size: 16px;
  width: 230px;
  height: 50px;
  display: block;
  margin-bottom: 30px;
  padding: 0 15px;
}

select.input-filed{
  border: 0px;
  border-radius: 10px;
}

input:focus{
  outline: none;
  border: 1px solid #FF8728;
  box-shadow: 0;
}

.input-filed-pass{
  margin-bottom: 10px !important;
}

    /* Checkmark for custom checkbox */
    input[type="checkbox"]:checked{
      background-color: #FF8728 !important;
      border-color: #FF8728 !important;
  }

  input[type="checkbox"]:checked {
      content: '✔';
      color: #FF8728 !important;
      font-size: 18px;
  }

  input[type="checkbox"] {
    -webkit-appearance: none;  /* For Webkit-based browsers like Chrome/Safari */
    -moz-appearance: none;     /* For Firefox */
    appearance: none;          /* Standard property for all browsers */
    width: 25px;
    height: 25px;
    border: 2px solid #231F20;
    border-radius: 5px;
    background-color: white;
    position: relative;
    cursor: pointer;
    transition: background-color 0.3s, border 0.3s;
}

/* Custom checkbox when checked */
input[type="checkbox"]:checked {
    background-color: #FF8728;
    border-color: #FF8728;
}

/* Checkmark inside the custom checkbox */
input[type="checkbox"]:checked::after {
    content: '✔';
    position: absolute;
    left: 4px;
    top: 2px;
    color: white;
    font-size: 16px;
}

input[type="file"] {
    border: 1px solid #231F20;
}

.info-button{
  color: #FF8728;
  position: absolute;
  top: 25%;
  right: 4%;
}


.forgot{
  font-size: 14px;
  color: #fff;
  text-align: right;
  text-decoration: none;
  line-height: 0;
}

a.button{
  display: block;
  padding: 10px 25px;
  background-color: #FF8728;
  color: #fff;
  margin: 0 auto !important;
  border: 0px;
  border-radius: 50px !important;
  height: 60px;
  width: 180px;
  font-size: 27px !important;
}

.form-container {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

label {
  font-weight: bold;
}

.actions {
  display: flex;
  justify-content: center;
  gap: 1rem;
}

.cdk-overlay-pane.mat-mdc-dialog-panel{
  width: 50vw !important;
}

.popup-header{
  width: 100%;
  display: flex;
  align-items: center;
  background-color: #E8E8E8;
  justify-content: flex-end;
  padding: 7px 30px;
}

.popup-header a{
  font-size: 20px;
  color: rgb(45, 45, 45);
  cursor: pointer;
  font-weight: normal;
}

.popup-body{
  padding: 10px 30px;
  width: 100%;
  min-width: 50%;
  height: auto;
}
.popup-body .table-scroll{
  height: 57vh;
} 
.popup-body label{
  margin-bottom: 10px;
}
.popup-body .input-filed{
  width: 100%;
  height: 40px;
  margin-bottom: 20px;
  border: 0;
  box-shadow: 0 2px 15px #0000001f, 0 3px 7px #0000001f;
  color: #231F20;
}
.popup-body .input-filed:focus{
  border: 0;
  outline: none;
}

button.toggle-btn{
  border: 0;
  background-color: transparent;
  padding: 0;
  color: #231F20;
}
button.toggle-btn .fa-solid.fa-toggle-on{
  color: #FF8728;
}
button.toggle-btn .fa-solid.fa-toggle-off{
  color: #FF8728;
}


header{
  width: 100%;
  padding: 15px 10px;
  background-color: #fff;
  box-shadow: 0 0px 4px rgba(0, 0, 0, 0.19), 0 2px 9px rgba(0, 0, 0, 0.23);
  position: fixed;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 11111111;
  height: 11vh;
}

header .logo{
  height: 40px;
  object-fit: contain;
}

.profile, .export {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}

.cursor{
  cursor: pointer;
}

.profile h3 {
  text-align: end;
  line-height: 1;
  margin-bottom: 4px;
  font-weight: 600;
}

.profile p {
  line-height: 1;
  font-size: 14px;
  opacity: .6;
  color: #000;
}

.profile .img-box {
  position: relative;
  width: 75px;
  height: 75px;
  border-radius: 50%;
  overflow: hidden;
}

.profile .img-box img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* menu (the right one) */

.menu, .exportmenu {
  position: absolute;
  top: calc(100% + 5px);
  right: 5px;
  width: 200px;
  min-height: 100px;
  background: #fff;
  box-shadow: 0 10px 20px rgba(0, 0, 0, .2);
  opacity: 0;
  transform: translateY(-10px);
  visibility: hidden;
  transition: 300ms;
}

.actionbuttons{
  position: relative;
}

.menu.active, .exportmenu.active {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
  border-radius: 10px !important;
background-color: #fff !important;
}
.exportmenu.active {
  z-index: 111111111111111111111111111111111111111;
  top: 65px;
}

/* menu links */

.menu ul, .exportmenu ul {
  position: relative;
  display: flex;
  flex-direction: column;
  z-index: 10;
  background: #fff;
  padding: 0px;
  margin:10px 0 ;
}

.menu ul li, .exportmenu ul li {
  list-style: none;
  border-bottom: 1px solid #f1f1f1;
}
.menu ul li:last-child, .exportmenu ul li:last-child {
  border: 0;
}

.menu ul li:hover, .exportmenu ul li:hover {
  background: #eee;
}

.menu ul li a, .exportmenu ul li a {
  text-decoration: none;
  color: #000;
  display: flex;
  align-items: center;
  padding: 15px 20px;
  gap: 6px;
}

.menu ul li a i .exportmenu ul li a i{
  font-size: 1.2em;
}


.left-side-bar{
  background-color: #231F20;
  height: 89vh;
}

.left-side-bar .card .card-body a .left-side-bar-title{
  display: none !important;
}
.left-side-bar:hover .card .card-body a .left-side-bar-title{
  display: block !important;
  padding-left: 10px;
}
.left-side-bar:hover .card .card-body a{
  display: flex !important;
  font-size: 0.9rem !important;
  align-items: center;
  padding: 6px 25px;
}
.left-side-bar .card h5 button .fa-solid.fa-chevron-down{
  display: none !important;
}
.left-side-bar:hover .card h5 button .fa-solid.fa-chevron-down{
  display: block !important;
}
.left-side-bar:hover .card h5 button{
  text-align: left;
  justify-content: space-between !important;
}
.left-side-bar .card h5 button{
  text-align: center;
  justify-content: center !important;
}

main{
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 89vh;
}

.card{
  border-radius: 0px !important;
}

.left-side-bar{
  padding: 0px !important;
  width: 5%;
  -webkit-transition: ease-out 0.5s;
  -moz-transition: ease-out 0.5s;
  transition: ease-out 0.5;
}
.left-side-bar:hover{
  padding: 0px !important;
  width: 15%;
  -webkit-transition: ease-out 0.5s;
  -moz-transition: ease-out 0.5s;
  transition: ease-out 0.5s;
}

.left-side-bar .card{
  border: 0px;
}

.left-side-bar .card-header{
  background-color: #231F20;
  border-radius: 0 !important;
  border: 1px solid #535353;
}

.left-side-bar .card h5 button{
  font-size: 1rem;
  padding: 0px;
  color: #fff;
  background-color: #231F20;
  text-decoration: none;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.left-side-bar .card .card-body{
  background-color: #F3F1F6;
  padding: 0;
}

.left-side-bar .card .card-body a {
  display: block;
  width: 100%;
  background-color: #F3F1F6;
  color: #231F20;
  padding: 10px 25px;
  font-size: 1.6rem;
  text-align: center;
  opacity: 0.5;
}
.left-side-bar .card .card-body a:hover{
  color: #fff;
  background-color: #FF8728;
  cursor: pointer;
  text-align: left;
}
.left-side-bar .card .btn-link:active{
  color: #fff;
}
.left-side-bar .card .card-body a.active {
  opacity: 1;
}

.right-side-container{
  width: 85%;
  padding: 10px;
  flex-grow: 1;
}

.right-side-content{
  border-radius: 15px;
  width: 100%;
  height: 100%;
  padding: 10px 30px;
  background-color: #F3F1F6;
  height: 86vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.table-scroll{
  flex-grow: 1;
  overflow-y: scroll;
  scrollbar-width: thin; /* For Firefox */
  scrollbar-color: #747474 #f0f0f0; /* For Firefox: color and background */
}

.pagination-controls {
  text-align: center;
  margin-top: 20px;
}

.pagination-controls button {
  padding: 10px;
  margin: 5px;
  cursor: pointer;
}

.pagination-controls span {
  font-size: 12px;
  margin: 0 10px;
}
.pagination-controls {
  margin-top: 20px;
  text-align: center;
}

.pagination-controls button {
  margin: 0 5px;
}

.pagination-controls span {
  margin: 0 10px;
}

.pagination-controls{
  display: flex;
  align-items: center;
  justify-content: center;
}

.pagination-controls button.export{
  width: 25px;
  height: 25px;
}
.pagination-controls button.export i{
  font-size: 10px;
}
.pagination-controls span{
  font-size: 10px;
}

/* For WebKit-based browsers (Chrome, Edge, Safari) */
.table-scroll::-webkit-scrollbar {
width: 10px; /* Width of the vertical scrollbar */
height: 10px; /* Height of the horizontal scrollbar */
}

.table-scroll::-webkit-scrollbar-track {
background: #f0f0f0; /* Background of the track */
}

.table-scroll::-webkit-scrollbar-thumb {
background-color: #FF8728; /* Scrollbar thumb color */
border-radius: 10px; /* Rounded corners */
border: 2px solid #f0f0f0; /* Adds space between thumb and track */
}

.table-scroll::-webkit-scrollbar-thumb:hover {
background-color: #FF8728; /* Change color on hover */
}

.table-scroll::-webkit-scrollbar-corner {
background: #f0f0f0; /* Corner background for when both scrollbars are visible */
}

.cdk-overlay-pane.mat-mdc-dialog-panel{
  width: 60vw;
}

.carousel-controls{
  position: absolute;
  top: 45%;
  width: 41%;
  display: flex;
  justify-content: space-between;
}
.crousal-img-container .crousal-img{
  width: 100%;
  height: 100vh;
  object-fit: cover;
  object-position: top;
}
.login-left-container{
padding: 0px !important;
}

.eye-icon{
position: absolute;
  top: 16px;
  right: 10px;
  color: #231F20;
  cursor: pointer;
}

.spare-image {
  width: 20px;  /* Adjust the size of the image */
  height: 20px; /* Adjust the size of the image */
  margin-right: 8px;  /* Space between the image and the text */
  vertical-align: middle;  /* Align image vertically with the text */
}

@media (min-width: 1200px) and (max-width: 1360px) {
  .login-right-container img {
      height: 45px;
  }
  .login-right-container .login-form h1{
      font-size: 36px;
  }
  .input-filed{
      width: 300px;
      height: 40px;
  }
  .crousal-container h1{
      font-size: 50px;
      padding-left: 70px;
  }
  .crousal-container p{
      font-size: 16px;
      padding-left: 70px;
  }
}

@media (max-width: 1200px) {
  .login-right-container img {
      height: 45px;
  }
  .login-right-container .login-form h1{
      font-size: 42px;
  }
  .input-filed{
      width: 300px;
  }
  .crousal-container h1{
      font-size: 46px;
      padding-left: 70px;
  }
  .crousal-container p{
      font-size: 15px;
      padding-left: 70px;
  }
}
@media (min-width: 992px) and (max-width: 1199px) {
  .login-right-container{
    right: 27%;
    top: 35%;
  }
}

@media screen and (max-width: 992px) {
  .login-right-container .login-form h1 {
      font-size: 34px;
  }

  .input-filed {
      width: 260px;
      font-size: 17px;
  }
  .crousal-container h1{
      font-size: 38px;
      padding-left: 50px;
  }
  .crousal-container p{
      padding-left: 50px;
  }
  a.button{
      width: 160px;
      font-size: 22px !important;
  }
}







/* dashboard */

/* Table Styles */
table {
margin: auto;
width: 100%;
overflow: hidden;
background-color: #fff; /* White background for the table */
border-radius: 10px;
position: relative;
border-collapse: collapse;
z-index: 1;
color: #2b3c56; /* Gray text color */
white-space: nowrap;
}

tbody tr:not(:last-child) {
border-bottom: 1px solid rgba(1, 1, 1, 0.2);
}

th,
td {
padding: 0.7rem;
gap: 10px;
position: relative;
cursor: default;
/* text-align: center !important; */
}
th:nth-child(2),
td:nth-child(2) {
text-align: left !important;
}

td:last-child:hover a {
color: #000; /* Black on hover */
}

thead {
background-color: #4400A5; /* Light blue background */
color: #fff;
}

th {
text-transform: uppercase;
font-weight: normal;
}

td img {
width: 11px;
height: 11px;
border-radius: 50%;
overflow: hidden;
margin-right: 5px;
}

tr:first-child:hover {
background-color: transparent; /* Light gray background on hover */
}
tr:hover {
background-color: #f9f9f9; /* Light gray background on hover */
}

td:last-child:hover:after {
content: "";
position: absolute;
width: fit-content;
transform: translate(0%, 50%);
font-size: 12px;
color: #f1f1f1; /* Light text color */
border-radius: 5px;
padding: 2px 4px;
z-index: 9;
}

table a {
color: #2b3c56; /* Gray link color */
}

/* ICONS */

/* .active,
.inactive {
padding: 0.3rem 0.8rem;
border-radius: 40px;
} */

/* .active {
background-color: transparent;
color: #107717;
} */
/*   
.inactive {
background-color: #FFBDBD;
color: #FF0000;
} */

@media (max-width: 720px) {
main {
  background: #5487fa; /* Blue */
}

table {
  background-color: transparent;
}

main {
  overflow-y: auto;
  height: 100%;
}

table thead {
  display: none;
}

table td {
  width: 100%;
  display: block;
  text-align: right;
}

table td:not(:last-child) {
  border-bottom: 1px solid rgba(1, 1, 1, 0.2);
}

table td:before {
  content: attr(data-label);
  z-index: 1;
  float: left;
  color: #000; /* Black */
}

tr {
  background-color: #fff; /* White */
  border-radius: 5px;
  display: block;
  margin: 0.5rem 0;
}

tbody tr {
  border-bottom: none;
}

tr td {
  text-align: right !important;
}

tr td:first-child {
  text-align: center !important;
}

tr td{
  text-align: center !important;
}

td:last-child:hover:after {
  left: auto;
  right: 10%;
  transform: translate(50%, 50%);
}

th,
td {
  padding: 0.5rem 1rem;
}
}

.fa-solid.fa-filter{
  padding-left: 20px;
}

hr{
  color: #FFFFFF;
}

h1.headline{
  font-size: 1.6em;
  color: #231F20;
  font-weight: 500;
  margin-top: 15px;
  margin-bottom: 0;
}
button{
  margin-top: 0 !important;
  padding: 10px 30px;
  color: #fff;
  background-color: #FF8728;
  border: 0;
  width: auto;
  border-radius: 50px !important;
}

button.add{
  background-color: transparent;
  padding: 0;
  color: #2b3c56;
}

.right-side-container .input-filed{
  height: 40px;
  margin-bottom: 0px;
}

.tabletopbuttons{
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.searchcontainer {
  display: flex;
  align-items: center;
}
.searchcontainer .input-filed{
  margin-right: 20px;
  height: 40px;
}

.actionbuttons{
  display: flex;
  align-items: flex-start;
}
.actionbuttons button{
  margin-left: 20px;
}

table .fa-solid:hover, table .fas:hover{
  color: #FF8728;
}


dialog{
width:100vw;
