/* dashboard */


.cdk-global-scrollblock{
  overflow: hidden !important;
}

button.export{
  height: 40px;
  width: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0px;
  font-size: 16px;
}

.custom-tooltip {
  background-color: #ff5722;
  color: white;
  font-size: 14px;
}
.status .fa-solid.fa-check{
  color: green;
}

.status .fa-solid.fa-xmark{
  color: red;
}