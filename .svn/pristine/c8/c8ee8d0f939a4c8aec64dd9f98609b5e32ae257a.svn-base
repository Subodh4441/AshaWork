<div id="accordion" *ngIf="viewPermissions['Tenant']">
  <div class="card">
    <div class="card-header" id="headingTenant">
      <h5 class="mb-0">
        <button class="btn btn-link" data-toggle="collapse" data-target="#collapseTenant" aria-expanded="true" aria-controls="collapseTenant">
          Tenant <i class="fa-solid fa-chevron-down"></i>
        </button>
      </h5>
    </div>
    <div id="collapseTenant" class="collapse show" aria-labelledby="headingTenant" data-parent="#accordion">
      <div class="card-body">
        <a (click)="selectTab('tenant')" [class.active]="activeTab === 'tenant'">
          <i class="fa-solid fa-video"></i>
          <span class="left-side-bar-title">Tenant</span>
        </a>
      </div>
    </div>
  </div>
</div>

<div id="accordion" *ngIf="!viewPermissions['Tenant']">
  <div class="card">
    <div class="card-header" id="headingOne">
      <h5 class="mb-0">
        <button class="btn btn-link" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
          Masters <i class="fa-solid fa-chevron-down"></i>
        </button>
      </h5>
    </div>
    <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordion">
      <div class="card-body">
        <a *ngIf="viewPermissions['Clients']" (click)="selectTab('clients')" [class.active]="activeTab === 'clients'">
          <i class="fa-solid fa-handshake"></i><span class="left-side-bar-title">Clients</span>
        </a>
        <a *ngIf="viewPermissions['Products']" (click)="selectTab('products')" [class.active]="activeTab === 'products'">
          <i class="fa-solid fa-box"></i><span class="left-side-bar-title">Products</span>
        </a>
        <a *ngIf="viewPermissions['Regions']" (click)="selectTab('regions')" [class.active]="activeTab === 'regions'">
          <i class="fa-solid fa-map"></i><span class="left-side-bar-title">Regions</span>
        </a>
        <a *ngIf="viewPermissions['Users']" (click)="selectTab('users')" [class.active]="activeTab === 'users'">
          <i class="fa-solid fa-users"></i><span class="left-side-bar-title">Users</span>
        </a>
        <a *ngIf="viewPermissions['Branches']" (click)="selectTab('branches')" [class.active]="activeTab === 'branches'">
          <i class="fa-solid fa-location-dot"></i><span class="left-side-bar-title">Branches</span>
        </a>
        <a *ngIf="viewPermissions['Spares']" (click)="selectTab('spare')" [class.active]="activeTab === 'spare'">
          <i class="fa-solid fa-gear"></i><span class="left-side-bar-title">Spares</span>
        </a>
        <a *ngIf="viewPermissions['Roles&Rights']" (click)="selectTab('rolesandrights')" [class.active]="activeTab === 'rolesandrights'">
          <i class="fa-solid fa-user-gear"></i><span class="left-side-bar-title">Role & Rights</span>
        </a>
        <a *ngIf="viewPermissions['Service Agency']" (click)="selectTab('service-agency')" [class.active]="activeTab === 'service-agency'">
          <i class="fa-solid fa-screwdriver-wrench"></i><span class="left-side-bar-title">Service Agency</span>
        </a>
        <a *ngIf="viewPermissions['Experia']" (click)="selectTab('experia')" [class.active]="activeTab === 'experia'">
          <i class="fa-solid fa-video"></i><span class="left-side-bar-title">Experia</span>
        </a>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-header" id="headingTwo">
      <h5 class="mb-0">
        <button class="btn btn-link collapsed" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
          CMS <i class="fa-solid fa-chevron-down"></i>
        </button>
      </h5>
    </div>
    <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordion">
    </div>
  </div>
</div>
