

  <div class="popup-header">
    <h3><b>{{savetext1}}</b></h3>

    <a (click)="onCancel()" aria-label="Close"><i class="fa-solid fa-xmark"></i></a>
</div>

<div class="popup-body">
    <div class="form-container">
        <div class="row" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <!-- Spare Variant -->
            <div class="col-xl-6 col-md-6 col-lg-6">
              <label class="d-block" for="tenantName">Tenant Name *:</label>
              <input 
                id="tenantName"
                type="text" 
                maxlength="40" 
                required 
                [(ngModel)]="tenantName" 
                placeholder="Enter Tenant Name" 
                class="input-filed" 
              />
            </div>
            <div class="col-xl-6 col-md-6 col-lg-6">
              <label  class="d-block" for="tenantHead">Tenant Head *:</label>
              <input 
                id="tenantHead"
                type="text" 
                maxlength="40" 
                required 
                [(ngModel)]="tenantHead" 
                placeholder="Enter Tenant Head" 
                class="input-filed" 
              />
            </div>
            <div class="col-xl-6 col-md-6 col-lg-6">
              <label class="d-block" for="tenantEmailID">Tenant Email ID *:</label>
              <input 
                id="tenantEmailID"
                type="email" 
                maxlength="50" 
                pattern="^[a-zA-Z0-9._%+-]+@gmail\.com$" 
                (input)="onClientNameInput1()" 
                [(ngModel)]="tenantEmailID" 
                placeholder="Enter Tenant Email" 
                class="input-filed" 
              />
              <div *ngIf="!isGmailValid && tenantEmailID" class="error-message">
                Please enter a valid Contact Email ID.
              </div>
            </div>
        </div>

      
  <div class="actions">
    <button (click)="onSaveTenant()">{{savetext}}</button>
 </div>
    </div>
</div>
