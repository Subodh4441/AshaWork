<div class="right-side-content">
  <h1 class="headline">Spares</h1>
   <hr>
  <div class="tabletopbuttons">
    <div class="searchcontainer">
      <input placeholder="Search" type="search" class="input-filed" [(ngModel)]="searchQuery" (ngModelChange)="onSearchChange()">
  </div>
  
    <!-- Add dropdown for selecting grid view -->
    <div class="grid-selector">
        <label for="gridSelector">Select Grid View</label>
        <select [(ngModel)]="selectedGrid" (ngModelChange)="onGridChange()" class="input-filed cursor">
            <option value="spareVariant">Spare Variant</option>
            <option value="spareName">Spare Name</option>
        </select>
    </div>
  
    <div class="actionbuttons">
      <!-- Button for Add SpareVariant -->
      <button class="export" title="Add SpareVariant"  (click)="handleClick()">
        <i class="fa-solid fa-plus"></i>
      </button>
    
  
    
      <!-- Export to PDF -->
      <button id="export-pdf" class="export" title="Export PDF" (click)="exportPDF()">
        <i class="fa-regular fa-file-pdf"></i>
      </button>
    
      <!-- Export to Excel -->
      <button id="export-excel" class="export" title="Export Excel" (click)="exportExcel()">
        <i class="fa-regular fa-file-excel"></i>
      </button>
    </div>
    
  </div>
  
  <div class="table-scroll">
    <table *ngIf="selectedGrid === 'spareVariant'">
        <thead>
            <tr>
                <th>Edit</th>
                <th>Spare Variant ID</th>
                <th>Spare Variant</th>
                <th>Spare Name</th>
                <th>Status</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            <tr *ngFor="let spares of sparesForCurrentPage">
                <td><i  title="Edit" class="fa-solid fa-pen-to-square cursor" (click)="handleeditClick(spares)"></i></td>
                <td>{{ spares.spareVariantID }}</td>
                <td>{{ spares.spareVariant }}</td>
                <td>{{ spares.spareName }}</td>
                <!-- <td>{{ spare.isActive ? 'Active' : 'Inactive' }}</td> -->
                <td class="status">
                  <i *ngIf="spares.isActive" class="fa-solid fa-check"></i>
                                
                  <i *ngIf="!spares.isActive" class="fa-solid fa-xmark"></i>
                </td>

                <td><i title="Delete"  class="fa-solid fa-trash" (click)="spares.spareVariantID ? handleDeleteClick(spares.spareVariantID) : null"></i></td>
            </tr>
        </tbody>
    </table>
  
    <table *ngIf="selectedGrid === 'spareName'">
        <thead>
            <tr>
                <th>Edit</th>
                <th>Spare Name</th>
                <th>Status</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
          <tr *ngFor="let sparesname of sparesForCurrentPage">
            <td><i   title="Edit" class="fa-solid fa-pen-to-square cursor" (click)="openEditClientPopupSpareName(sparesname)"></i></td>
            <td>{{ sparesname.spareName }}</td>
            <!-- <td>{{ sparesname.isActive ? 'Active' : 'Inactive' }}</td> -->
            <td class="status">
            <i *ngIf="sparesname.isActive" class="fa-solid fa-check"></i>
                          
            <i *ngIf="!sparesname.isActive" class="fa-solid fa-xmark"></i>
          </td>

            <td><i  title="Delete"  class="fa-solid fa-trash" (click)="sparesname.spareID ? onDeleteSpare(sparesname.spareID) : null"></i></td>
          </tr>
        </tbody>
    </table>
  
    <!-- <div class="pagination-controls"> 
        <button (click)="changePage(1)" [disabled]="currentPage === 1">First</button>
        <button (click)="changePage(currentPage - 1)" [disabled]="currentPage === 1">Previous</button>
        <span>Page {{ currentPage }} of {{ totalPages }}</span>
        <button (click)="changePage(currentPage + 1)" [disabled]="currentPage === totalPages">Next</button>
        <button (click)="changePage(totalPages)" [disabled]="currentPage === totalPages">Last</button>
    </div> -->
  
    <div class="pagination-controls">
      <button class="export" (click)="changePage(1)" [disabled]="currentPage === 1"><i title="Start" class="fa-solid fa-angles-left"></i></button>
      <button class="export" (click)="changePage(currentPage - 1)" [disabled]="currentPage === 1"><i title="Previous"class="fa-solid fa-arrow-left"></i></button>
      <span>Page {{ currentPage }} of {{ totalPages }}</span>
      <button class="export" (click)="changePage(currentPage + 1)" [disabled]="currentPage === totalPages"><i title="Next"class="fa-solid fa-arrow-right"></i></button>
      <button class="export" (click)="changePage(totalPages)" [disabled]="currentPage === totalPages"><i title="End" class="fa-solid fa-angles-right"></i></button>
    </div>
  </div>
</div>