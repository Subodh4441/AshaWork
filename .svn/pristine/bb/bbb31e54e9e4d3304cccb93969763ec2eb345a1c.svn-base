<div class="right-side-content">
  
    <div class="tabletopbuttons">
      <div class="searchcontainer">
        <input placeholder="Search" type="search" class="input-filed" [(ngModel)]="searchQuery" (ngModelChange)="onSearchChange()">
      </div>
      <div class="actionbuttons">
        <button class="export" title="Add Service Agency" [ngClass]="{'disabled': !hasAddPermission}" (click)="handleClick()">
          <i class="fa-solid fa-plus"></i>
          <!-- <i class="fa-solid fa-cart-plus"></i> -->
        </button>
        <!-- <button id="" class="export" title="Bulk Upload" (click)="openbulkPopup('P')">
          <i class="fa-solid fa-upload"></i>
        </button> -->
  
        <button id="export-pdf" class="export" title="Export PDF" (click)="exportPDF()">
          <i class="fa-regular fa-file-pdf"></i>
        </button>
  
        <button id="export-excel" class="export" title="Export Excel" (click)="exportExcel()">
          <i class="fa-regular fa-file-excel"></i>
        </button>
     
      </div>
    </div>
  
    <div class="table-scroll">
        <table>
            <thead>
              <tr>
                <th>Edit</th>
                <th>Service Agency Name</th>
                <th>State</th>
                <th>City</th>
                <th>Address</th>
                <th>Pin Code</th>
                <th>Contact Name</th>
                <th>Contact Number</th>
                <th>Contact Email ID</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let serviceAgency of serviceForCurrentPage">
                <td data-label="Edit">
                  <i
                        title="Edit"
                        class="fa-solid fa-pen-to-square cursor"
                        (click)="handleeditClick(serviceAgency)"
                      ></i>
                </td>
                <td data-label="Service Agency Name">{{ serviceAgency.serviceAgencyName }}</td>
                <td data-label=>{{ serviceAgency.stateName }}</td>
                <td data-label="City ID">{{ serviceAgency.cityName }}</td>
                <td data-label="Address">{{ serviceAgency.address }}</td>
                <td data-label="Pin Code">{{ serviceAgency.pinCode }}</td>
                <td data-label="Contact Name">{{ serviceAgency.contactName }}</td>
                <td data-label="Contact Mobile">{{ serviceAgency.contactMobile }}</td>
                <td data-label="Contact Email">{{ serviceAgency.contactEmail }}</td>
                <!-- <td data-label=>{{ serviceAgency.active ? 'Active' : 'Inactive' }}</td> -->
                <td data-label="Status">
                  <i *ngIf="serviceAgency.active" class="fa-solid fa-check"></i>
                          
                  <i *ngIf="!serviceAgency.active" class="fa-solid fa-xmark"></i>
                      <!-- <input
                      class="form-check-input"
                      type="checkbox"
                      id="activeCheckbox"
                      [(ngModel)]="serviceAgency.active"
                      name="Status"
                      disabled="true"
                    /> -->
              </td>


              </tr>
            </tbody>
          </table>

      <div class="pagination-controls">
        <button class="export" (click)="changePage(1)" [disabled]="currentPage === 1"><i title="Start" class="fa-solid fa-angles-left"></i></button>
        <button class="export" (click)="changePage(currentPage - 1)" [disabled]="currentPage === 1"><i title="Privious" class="fa-solid fa-arrow-left"></i></button>
        <span>Page {{ currentPage }} of {{ totalPages }}</span>
        <button class="export" (click)="changePage(currentPage + 1)" [disabled]="currentPage === totalPages"><i title="Next" class="fa-solid fa-arrow-right"></i></button>
        <button class="export" (click)="changePage(totalPages)" [disabled]="currentPage === totalPages"><i title="End" class="fa-solid fa-angles-right"></i></button>
      </div>
      
    </div>
  </div>
  