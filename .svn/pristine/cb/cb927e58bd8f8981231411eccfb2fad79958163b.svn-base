<app-tabset [tabs]="dynamicTabs" [activeTabId]="defaultActiveTab"></app-tabset>

<div>
    <!-- Tab Navigation -->
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item" *ngFor="let tab of tabs">
        <a
          class="nav-link"
          [class.active]="tab.id === selectedTabId"
          [id]="'tab-' + tab.id"
          data-bs-toggle="tab"
          [href]="'#content-' + tab.id"
          role="tab"
          [attr.aria-controls]="'content-' + tab.id"
          [attr.aria-selected]="tab.id === selectedTabId"
          (click)="selectTab(tab.id)"
        >
          {{ tab.label }}
        </a>
      </li>
    </ul>
  
    <!-- Tab Content -->
    <div class="tab-content">
      <div
        class="tab-pane fade"
        *ngFor="let tab of tabs"
        [class.show]="tab.id === selectedTabId"
        [class.active]="tab.id === selectedTabId"
        [id]="'content-' + tab.id"
        role="tabpanel"
        [attr.aria-labelledby]="'tab-' + tab.id"
      >
        <h4>{{ tab.label }}</h4>
        <p>{{ tab.content }}</p>
      </div>
    </div>
  </div>
  