<div class="popup-header">
  <a (click)="onCancel()"><i class="fa-solid fa-xmark"></i></a>
</div>
<div class="popup-body">
  <div class="form-container">
      <!-- Add form fields or data if required -->
  </div>
  <h2>Upload {{ entityType }}</h2>
  <input type="file" (change)="onFileChange($event)"/>
  <div *ngIf="previewData.length > 0">
    <h3>Preview Data</h3>
    <table>
      <thead>
        <tr>
          <th *ngFor="let field of fields">{{ field }}</th>
        </tr>
      </thead>
      <tbody>
        <tr *ngFor="let row of previewData">
          <td *ngFor="let cell of row">{{ cell }}</td>
        </tr>
      </tbody>
    </table>
  </div>
 
 
  <div class="actions mt-4">
      <!-- Upload Button -->
      <button (click)="onSubmit()">Submit</button>
  </div>
</div>

