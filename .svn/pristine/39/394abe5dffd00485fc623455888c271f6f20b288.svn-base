.popup-header {
    display: flex;
    justify-content: space-between; /* This will make the header elements spaced out */
    align-items: center;  /* Vertically centers the text and the X button */
  }
 
  .popup-header h3 {
    margin: 0; /* Removes default margin to keep it left aligned */
    flex-grow: 1; /* Makes sure the h3 takes the remaining space on the left */
  }
 
  .close-button {
    font-size: 20px;  /* Adjust the size of the close button */
    cursor: pointer;  /* Adds a pointer cursor when hovering over the button */
  }
 