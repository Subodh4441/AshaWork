

<div class="right-side-content">
  <h1 class="headline">Regions</h1>
  <hr>

  <div class="tabletopbuttons">
    <div class="searchcontainer">
      <input placeholder="Search" type="search" class="input-filed" [(ngModel)]="searchQuery" (ngModelChange)="onSearchChange()">
    </div>

    <div class="actionbuttons" >
      <select id="region-category"  [(ngModel)]="selectedRegionCategory" (change)="filterRegionList()" class="input-filed cursor">
        <option *ngFor="let category of regionCategories" [value]="category.value">{{ category.label }}</option>
      </select>
    </div>

    <!-- <div class="actionbuttons">
      <select
        id="region-category"
        [(ngModel)]="selectedRegionCategory"
        (change)="onRegionCategoryChange()"
        class="input-filed"
      >
        <option *ngFor="let category of regionCategories" [value]="category.value">
          {{ category.label }}
        </option>
      </select>
    </div> -->
  
    <div class="actionbuttons">
      <button class="export" title="Add Region" (click)="handleClick()">
        <!-- <i class="fa-solid fa-map-pin"><i class="fa-solid fa-plus"></i></i> -->
        <i class="fa-solid  fa-plus"></i>
        <!-- <i class="fa-solid fa-map-location-dot"></i> -->
       
        
      </button>

      <button id="export-pdf" class="export" title="Export PDF" (click)="exportPDF()">
        <i class="fa-regular fa-file-pdf"></i>
      </button>
    
      <button id="export-excel" class="export" title="Export Excel" (click)="exportExcel()">
        <i class="fa-regular fa-file-excel"></i>
      </button>

    </div>
  </div>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th style="width: 100px;">Edit</th>
        <th *ngIf="selectedRegionCategory === 'Country' || selectedRegionCategory === 'State' || selectedRegionCategory === 'City'">Country</th>
        <th *ngIf="selectedRegionCategory === 'State' || selectedRegionCategory === 'City'">State</th>
        <th *ngIf="selectedRegionCategory === 'City'">City</th>
      </tr>
    </thead>
    <tbody>
      <tr *ngFor="let region of regionForCurrentPage">
        <td data-label="Edit"><i  title="Edit" class="fa-solid fa-pen-to-square cursor" (click)="handleeditClick(region)"></i></td>
        <td *ngIf="selectedRegionCategory === 'Country' || selectedRegionCategory === 'State' || selectedRegionCategory === 'City'" data-label="Country">{{ region.countryName }}</td>
        <td *ngIf="selectedRegionCategory === 'State' || selectedRegionCategory === 'City'" data-label="State">{{ region.stateName }}</td>
        <td *ngIf="selectedRegionCategory === 'City'" data-label="City">{{ region.cityName }}</td>
      </tr>
    </tbody>
  </table>
</div>
  <div class="pagination-controls">
    <button class="export" (click)="changePage(1)" [disabled]="currentPage === 1"><i class="fa-solid fa-angles-left"></i></button>
    <button class="export" (click)="changePage(currentPage - 1)" [disabled]="currentPage === 1"><i class="fa-solid fa-arrow-left"></i></button>
    <span>Page {{ currentPage }} of {{ totalPages }}</span>
    <button class="export" (click)="changePage(currentPage + 1)" [disabled]="currentPage === totalPages"><i class="fa-solid fa-arrow-right"></i></button>
    <button class="export" (click)="changePage(totalPages)" [disabled]="currentPage === totalPages"><i class="fa-solid fa-angles-right"></i></button>
  </div>
</div>

