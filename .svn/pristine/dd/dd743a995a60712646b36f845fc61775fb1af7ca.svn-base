<div class="body">


  <div class="content">
    <div>
      <div class="tabset">
        <!-- Tab 1 -->
        <input type="radio" name="tabset" id="tab1" aria-controls="marzen">
        <label for="tab1" (click)="onUserClick()">User</label>
        <input type="radio" name="tabset" id="tab2" aria-controls="rauchbier" checked>
        <label for="tab2">Role</label>

        <div class="tab-panels">
          <section id="marzen" class="tab-panel"></section>
          <section id="rauchbier" class="tab-panel">
            <main>
              <div class="tab-header">
                <div>
                  <h4>Role</h4>
                </div>
                <div>
                  <button (click)="openAddRoleModel()">Add Role</button>
                </div>
              </div>
              <div class="d-flex align-items-center mb-3">
                <!-- <input placeholder="Serach" type="search" name="" id=""><button>Search</button> -->
                <input 
                placeholder="Search" 
                type="search" 
                [(ngModel)]="searchQuery" 
                (ngModelChange)="searchTable()"
                class="form-control search-box"/>
  
              </div>
              <table>
                <thead>
                  <tr>
                    <th style="width: 50%;">Role</th>
                    <th>ManagePermission</th>
                    <th>Active</th>
                    <th>Delete</th>
                    <th>Edit</th>
                  </tr>
                </thead>
                <tbody>
                  <ng-container *ngIf="filteredRoles && filteredRoles.length > 0; else noRecords">
                  <tr *ngFor="let roles of filteredRoles  | paginate: { itemsPerPage: 7, currentPage: page }">
                    <td data-label="roleName" style="width: 40%;">{{roles.roleName}}</td>
                    <td data-label="rolepermission" (click)="openRolePermissionModel(roles.roleId)"><i
                        class="fa-solid fa-gear"></i></td>
                    <td>
                      <span class="status-icon" [ngClass]="roles.isActive ? 'text-success' : 'text-danger'"
                        (click)="openChangeStatusModal(roles.roleId,roles.isActive)" style="padding: 0; border: none; background: transparent; cursor: pointer; 
                          display: flex; justify-content: center; align-items: center; 
                          width: 40px; height: 40px;">
                        {{ roles.isActive ? '✔' : '✘' }}
                      </span>
                    </td>
                    <td>
                      <button class="btn btn-link" style="padding: 0; border: none; background: transparent; cursor: pointer; 
                          display: flex; justify-content: center; align-items: center; 
                          width: 40px; height: 40px;" (click)="openDeleteRoleModal(roles.roleId)">
                        <i class="fa-solid fa-trash fa-lg" style="color: rgb(158, 11, 11);"></i>
                      </button>
                    </td>
                    <td>
                      <button class="btn btn-link" style="padding: 0; border: none; background: transparent; cursor: pointer; 
                          display: flex; justify-content: center; align-items: center; 
                          width: 40px; height: 40px;" (click)="openEditRoleModel(roles.roleId)">
                        <i class="fa-solid fa-pen-to-square" style="color: rgb(43, 42, 41);"></i>
                      </button>
                    </td>
                  </tr>
                </ng-container>
                </tbody>
              </table>
              <ng-template #noRecords>
                <tr>
                  <td colspan="7" class="text-center">
                    <div class="no-records-message">No records found</div>
                  </td>
                </tr>
              </ng-template>
            </main>
            <!-- Modal for Adding Role -->
            <div class="modal fade" id="addRoleModal" tabindex="-1" aria-labelledby="addRoleModalLabel"
              aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="addRoleModalLabel">Add New Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <form (ngSubmit)="onAddRole()">
                      <div class="mb-3">
                        <label for="rolename" class="form-label">RoleName</label>
                        <input type="text" id="rolename" class="form-control" [(ngModel)]="newRole.rolename"
                          name="rolename" required>
                      </div>
                      <div class="mb-3">
                        <label for="isModerator" class="form-label">IsModerate</label>
                        <input type="checkbox" id="isModerator" [(ngModel)]="newRole.ismoderator"
                          name="isModerator" required>
                      </div>
                      <button type="submit" class="btn btn-primary">Save User</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-labelledby="deleteRoleModalLabel"
              aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="deleteRoleModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    Are you sure you want to delete this role?
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="button" class="btn btn-danger" (click)="deleteRole(currentRoleId)">Yes</button>
                  </div>
                </div>
              </div>
            </div>
            <!-- Status Confirmation Modal -->
            <div class="modal fade" id="changeStatusModal" tabindex="-1" aria-labelledby="changeStatusModalLabel"
              aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="changeStatusModalLabel">Change Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <p>Are you sure you want to change the status?</p>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" (click)="updateStatus()">Confirm</button>
                  </div>
                </div>
              </div>
            </div>
            <!-- Modal for Edit Role -->
            <div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel"
              aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="editRoleModalLabel">Edit Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <!-- RoleName Field -->
                    <div class="mb-3">
                      <label for="rolename">RoleName</label>
                      <input type="text" class="form-control" [(ngModel)]="newRole.rolename" id="rolename" />
                    </div>

                    <!-- IsModerator Field (checked) -->
                    <div class="mb-3">
                      <label for="isModerator">IsModerator</label>
                      <input type="checkbox" [(ngModel)]="newRole.ismoderator" id="isModerator"
                        readonly />
                    </div>

                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" (click)="onEditRole()">Save Changes</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Modal for Manage Permissions -->
            <div class="modal fade" id="rolePermissionModal" tabindex="-1" aria-labelledby="rolePermissionModalLabel"
              aria-hidden="true">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="rolePermissionModalLabel">Add New Role</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    <form (ngSubmit)="onSavePermissions()">
                      <table class="table">
                        <thead>
                          <tr>
                            <th>MenuName</th>
                            <th>Is Add</th>
                            <th>Is Edit</th>
                            <th>Is Display</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr *ngFor="let permission of rolePermission; let i = index">
                            <td>
                             {{permission.menuName}}
                            </td>
                            <td>
                              <input type="checkbox" [(ngModel)]="permission.isAdd" [name]="'isAdd_' + i">
                            </td>
                            <td>
                              <input type="checkbox" [(ngModel)]="permission.isEdit" [name]="'isEdit_' + i">
                            </td>
                            <td>
                              <input type="checkbox" [(ngModel)]="permission.isDisplay" [name]="'isDisplay_' + i">
                            </td>
                          </tr>
                        </tbody>
                      </table>
                      <button type="submit" class="btn btn-primary">Save User</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</div>